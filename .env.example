# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Base URL of your Supabase project (e.g., https://xyz.supabase.co)
SUPABASE_URL=MY_SUPABASE_URL_PLACEHOLDER

# SUPABASE_ANON_KEY: Public anonymous API Key from your Supabase settings
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY_PLACEHOLDER
